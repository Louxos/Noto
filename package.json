{
  "name": "noto",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "description": "Noto — suite documentaire locale pour Windows : lire, éditer, imprimer et traiter vos fichiers, sans compte ni cloud. Gratuit et open source (MIT).",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "verify": "npm run pages:check && npm run lint && npm run check && npm run build",
    "pages:sync": "node scripts/sync-pages-root.mjs",
    "pages:check": "node scripts/sync-pages-root.mjs --check",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --environment node",
    "check": "tsc -b && vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "diff": "^9.0.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "minisearch": "^7.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^5.1.1",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.30",
    "@types/react-dom": "^18.3.7",
    "@types/utif": "^3.0.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "author": {
    "name": "Louxos"
  },
  "homepage": "https://github.com/Louxos/Noto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Louxos/Noto.git"
  },
  "bugs": {
    "url": "https://github.com/Louxos/Noto/issues"
  },
  "keywords": [
    "tauri",
    "react",
    "typescript",
    "pdf",
    "ocr",
    "images",
    "local-first",
    "privacy",
    "windows"
  ],
  "engines": {
    "node": ">=20.19"
  }
}
