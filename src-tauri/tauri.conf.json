{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noto",
  "version": "0.1.0",
  "identifier": "dev.noto.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Noto",
        "width": 1440,
        "height": 940,
        "minWidth": 820,
        "minHeight": 580,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; worker-src 'self' blob:; frame-src 'self' blob: data:; object-src 'none'; base-uri 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "publisher": "Noto",
    "homepage": "https://github.com/Louxos/Noto",
    "copyright": "Copyright © 2026 Noto contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Lecteur et éditeur de fichiers local",
    "longDescription": "Noto ouvre et organise localement vos fichiers texte, Markdown, PDF, images et documents courants, dans un espace de lecture clair et simple. Aucun compte ni synchronisation : vos fichiers restent sur votre appareil.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["French", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/installer/nsis-header.bmp",
        "uninstallerHeaderImage": "windows/installer/nsis-header.bmp",
        "sidebarImage": "windows/installer/nsis-sidebar.bmp",
        "startMenuFolder": "Noto"
      },
      "wix": {
        "language": "fr-FR",
        "bannerPath": "windows/installer/wix-banner.bmp",
        "dialogImagePath": "windows/installer/wix-dialog.bmp"
      }
    },
    "fileAssociations": [
      { "ext": ["md", "markdown", "mdown", "mkd"], "name": "Document Markdown", "description": "Document Markdown", "role": "Viewer", "mimeType": "text/markdown" },
      { "ext": ["txt", "text", "log", "diff", "patch", "ini", "env", "toml", "conf", "editorconfig", "gitignore", "gitattributes", "properties", "tex", "rst", "adoc", "asciidoc"], "name": "Fichier texte", "description": "Fichier texte", "role": "Viewer", "mimeType": "text/plain" },
      { "ext": ["js", "mjs", "cjs", "ts", "jsx", "tsx", "css", "scss", "sass", "less", "json", "jsonc", "json5", "xml", "yaml", "yml", "py", "pyw", "java", "c", "cc", "cpp", "cxx", "h", "hpp", "hxx", "cs", "php", "sql", "sh", "bash", "zsh", "bat", "cmd", "ps1", "psm1", "psd1", "rs", "go", "rb", "swift", "kt", "kts", "vue", "svelte", "astro", "r", "lua", "scala", "dart", "ex", "exs", "erl", "hs", "clj", "groovy", "gradle", "vb", "fs", "proto", "graphql", "dockerfile", "makefile", "cmake", "tf", "hcl", "nix", "sol", "pkl", "lock"], "name": "Fichier de code", "description": "Fichier source ou de configuration", "role": "Editor", "mimeType": "text/plain" },
      { "ext": ["html", "htm"], "name": "Document HTML", "description": "Document HTML", "role": "Viewer", "mimeType": "text/html" },
      { "ext": ["pdf"], "name": "Document PDF", "description": "Document PDF", "role": "Viewer", "mimeType": "application/pdf" },
      { "ext": ["png", "apng", "jpg", "jpeg", "gif", "webp", "bmp", "svg", "ico", "tif", "tiff", "avif"], "name": "Image", "description": "Fichier image", "role": "Viewer", "mimeType": "image/*" },
      { "ext": ["csv"], "name": "Fichier CSV", "description": "Fichier de données CSV", "role": "Viewer", "mimeType": "text/csv" },
      { "ext": ["tsv"], "name": "Fichier TSV", "description": "Fichier de données tabulaires", "role": "Viewer", "mimeType": "text/tab-separated-values" },
      { "ext": ["pptx"], "name": "Présentation PowerPoint", "description": "Présentation PowerPoint", "role": "Viewer", "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation" },
      { "ext": ["odp"], "name": "Présentation OpenDocument", "description": "Présentation OpenDocument", "role": "Viewer", "mimeType": "application/vnd.oasis.opendocument.presentation" },
      { "ext": ["docx"], "name": "Document Word", "description": "Document Word", "role": "Viewer", "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document" },
      { "ext": ["odt"], "name": "Document OpenDocument", "description": "Document OpenDocument", "role": "Viewer", "mimeType": "application/vnd.oasis.opendocument.text" },
      { "ext": ["rtf"], "name": "Document RTF", "description": "Document RTF", "role": "Viewer", "mimeType": "application/rtf" },
      { "ext": ["epub"], "name": "Livre numérique EPUB", "description": "Livre numérique EPUB", "role": "Viewer", "mimeType": "application/epub+zip" }
    ]
  },
  "plugins": {}
}
