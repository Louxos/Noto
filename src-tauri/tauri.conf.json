{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noto",
  "version": "1.2.0",
  "identifier": "dev.noto.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Noto",
        "width": 1440,
        "height": 940,
        "minWidth": 820,
        "minHeight": 580,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 https://api.github.com; worker-src 'self' blob:; frame-src 'self' blob: data:; object-src 'none'; base-uri 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "publisher": "Louxos Corporation",
    "homepage": "https://github.com/Louxos/Noto",
    "copyright": "Copyright © 2026 Louxos Corporation contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Suite documentaire locale : lire, éditer, traiter",
    "longDescription": "Noto rassemble lecture, édition, impression et traitement local de fichiers texte, code, PDF, images, tableaux et documents. Aucun compte, aucun cloud et aucune télémétrie : vos documents restent sur votre appareil.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "French"
        ],
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/installer/nsis-header.bmp",
        "uninstallerHeaderImage": "windows/installer/nsis-header.bmp",
        "sidebarImage": "windows/installer/nsis-sidebar.bmp",
        "installerHooks": "windows/installer/hooks.nsh",
        "startMenuFolder": "Noto"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Document Markdown",
        "description": "Document Markdown",
        "role": "Viewer",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "txt",
          "text",
          "log",
          "rst",
          "adoc",
          "asciidoc"
        ],
        "name": "Fichier texte",
        "description": "Fichier texte",
        "role": "Viewer",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "diff",
          "patch"
        ],
        "name": "Fichier de comparaison",
        "description": "Fichier de comparaison",
        "role": "Viewer",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "ini",
          "env",
          "toml",
          "conf",
          "config",
          "editorconfig",
          "gitignore",
          "gitattributes",
          "properties",
          "tf",
          "hcl",
          "lock"
        ],
        "name": "Fichier de configuration",
        "description": "Fichier de configuration",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "tex",
          "latex"
        ],
        "name": "Document LaTeX",
        "description": "Document LaTeX",
        "role": "Viewer",
        "mimeType": "text/x-tex"
      },
      {
        "ext": [
          "js",
          "mjs",
          "cjs",
          "ts",
          "jsx",
          "tsx",
          "css",
          "scss",
          "sass",
          "less",
          "py",
          "pyw",
          "java",
          "c",
          "cc",
          "cpp",
          "cxx",
          "h",
          "hh",
          "hpp",
          "hxx",
          "cs",
          "php",
          "sql",
          "rs",
          "go",
          "rb",
          "swift",
          "kt",
          "kts",
          "r",
          "lua",
          "pl",
          "scala",
          "dart",
          "ex",
          "exs",
          "erl",
          "hs",
          "elm",
          "clj",
          "cljs",
          "groovy",
          "gradle",
          "vb",
          "vbs",
          "fs",
          "fsx",
          "proto",
          "graphql",
          "gql",
          "dockerfile",
          "makefile",
          "mk",
          "cmake",
          "nix",
          "sol",
          "pkl"
        ],
        "name": "Fichier de code",
        "description": "Fichier source de programmation",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "html",
          "htm",
          "vue",
          "svelte",
          "astro"
        ],
        "name": "Document web",
        "description": "Document web",
        "role": "Viewer",
        "mimeType": "text/html"
      },
      {
        "ext": [
          "sh",
          "bash",
          "zsh",
          "fish",
          "bat",
          "cmd",
          "ps1",
          "psm1",
          "psd1"
        ],
        "name": "Script en ligne de commande",
        "description": "Script en ligne de commande",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "json",
          "jsonc",
          "json5",
          "ipynb"
        ],
        "name": "Fichier JSON",
        "description": "Fichier JSON",
        "role": "Viewer",
        "mimeType": "application/json"
      },
      {
        "ext": [
          "xml"
        ],
        "name": "Fichier XML",
        "description": "Fichier XML",
        "role": "Viewer",
        "mimeType": "application/xml"
      },
      {
        "ext": [
          "yaml",
          "yml"
        ],
        "name": "Fichier YAML",
        "description": "Fichier YAML",
        "role": "Viewer",
        "mimeType": "application/yaml"
      },
      {
        "ext": [
          "csv"
        ],
        "name": "Fichier CSV",
        "description": "Fichier de données CSV",
        "role": "Viewer",
        "mimeType": "text/csv"
      },
      {
        "ext": [
          "tsv"
        ],
        "name": "Fichier TSV",
        "description": "Fichier de données tabulaires",
        "role": "Viewer",
        "mimeType": "text/tab-separated-values"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "Document PDF",
        "description": "Document PDF",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "png",
          "apng",
          "jpg",
          "jpeg",
          "gif",
          "webp",
          "bmp",
          "svg",
          "ico",
          "tif",
          "tiff",
          "avif"
        ],
        "name": "Image",
        "description": "Fichier image",
        "role": "Viewer",
        "mimeType": "image/*"
      },
      {
        "ext": [
          "docx"
        ],
        "name": "Document Word",
        "description": "Document Word",
        "role": "Viewer",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": [
          "odt"
        ],
        "name": "Document OpenDocument",
        "description": "Document OpenDocument",
        "role": "Viewer",
        "mimeType": "application/vnd.oasis.opendocument.text"
      },
      {
        "ext": [
          "rtf"
        ],
        "name": "Document RTF",
        "description": "Document RTF",
        "role": "Viewer",
        "mimeType": "application/rtf"
      },
      {
        "ext": [
          "pptx"
        ],
        "name": "Présentation PowerPoint",
        "description": "Présentation PowerPoint",
        "role": "Viewer",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      },
      {
        "ext": [
          "odp"
        ],
        "name": "Présentation OpenDocument",
        "description": "Présentation OpenDocument",
        "role": "Viewer",
        "mimeType": "application/vnd.oasis.opendocument.presentation"
      },
      {
        "ext": [
          "epub"
        ],
        "name": "Livre numérique EPUB",
        "description": "Livre numérique EPUB",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      }
    ],
    "resources": {
      "icons/filetypes": "filetypes"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "untrusted comment: minisign public key: CE2B3D00FD2D39E4\nRWTkOS39AD0rztBMuLHRhoPG8LTWiWYA5lxxLcDaXEKte09TfgzzZJTW",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/Louxos/Noto/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
