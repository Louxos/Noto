{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions nécessaires à l’ouverture et à la sauvegarde de fichiers choisis par l’utilisateur, ainsi qu’au basculement de la fenêtre en plein écran.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-open",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-stat",
    "fs:allow-rename",
    "fs:allow-exists",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen"
  ]
}
