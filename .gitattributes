# Normalisation des fins de ligne : le dépôt est en LF, les outils Windows
# reçoivent ce qu’ils attendent.
* text=auto eol=lf

# Fichiers binaires : jamais de conversion de fin de ligne.
*.bmp binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.tif binary
*.tiff binary
*.gif binary
*.pdf binary
*.wasm binary
*.exe binary

# Scripts Windows conservés en CRLF, comme les attendent les outils de compilation.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Fichiers générés : exclus des statistiques de langue de GitHub.
package-lock.json linguist-generated=true -diff
Cargo.lock linguist-generated=true
